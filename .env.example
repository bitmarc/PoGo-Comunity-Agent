# ---------- Azure OpenAI / Foundry ----------
AZURE_OPENAI_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_OPENAI_API_KEY=                      # vacío en Azure: se usa Managed Identity
# NO la pongas salvo que sepas por que. Cada cliente de MAF elige el api-version
# correcto para su superficie (Responses -> "preview"). Fijar un valor aqui rompe
# la llamada con: 400 BadRequest "API version not supported".
# AZURE_OPENAI_API_VERSION=
HXQ_CHAT_DEPLOYMENT=gpt-5.6-luna
HXQ_IMAGE_DEPLOYMENT=gpt-image-1.5

# ---------- Auth (Google OAuth) ----------
# Consola: https://console.cloud.google.com/apis/credentials
# Redirect URI local: http://localhost:8000/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Genera con: python -c "import secrets;print(secrets.token_hex(32))"
CHAINLIT_AUTH_SECRET=
# Correos con acceso, separados por coma. Vacío = nadie entra.
HXQ_ADMIN_EMAILS=marcoarojas.95@gmail.com

# ---------- Tools (Fase 1) ----------
TAVILY_API_KEY=

